---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Calculator from "../components/Calculator.astro";
import Footer from "../components/Footer.astro";
import { parseCalcParams } from "../scripts/params";

export const prerender = false;

// Render the requested locale and amounts on the server so the first paint
// (and link-preview crawlers) see the right language and numbers.
const params = parseCalcParams(Astro.url.searchParams);
---

<Layout params={params}>
  <Calculator params={params}>
    <Header slot="header" locale={params.locale} />
    <Footer slot="footer" locale={params.locale} />
  </Calculator>
</Layout>
